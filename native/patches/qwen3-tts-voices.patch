+    bool set_voice(const std::string & path) {
+        auto cached = voices_.find(path);
+        if (cached != voices_.end()) {
+            embedding_ = cached->second;
+            return true;
+        }
+        std::vector<float> samples;
+        int rate = 0;
+        if (!qwen3_tts::load_audio_file(path, samples, rate)) {
+            error_ = "failed to load voice reference: " + path;
+            return false;
+        }
+        if (rate != 24000) samples = resample_linear(samples, rate, 24000);
+        std::vector<float> embedding;
+        if (!tts_.extract_speaker_embedding(samples.data(), (int32_t)samples.size(), embedding, params_)) {
+            error_ = "failed to extract speaker embedding for " + path + ": " + tts_.get_error();
+            return false;
+        }
+        voices_[path] = embedding;
+        embedding_ = std::move(embedding);
+        return true;
+    }
